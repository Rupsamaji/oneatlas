generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Model { id String @id @default(cuid()) name String slug String @unique provider String category String description String contextWindow Int inputPrice Float outputPrice Float score Float }
model Provider { id String @id @default(cuid()) name String slug String @unique description String website String }
model Lab { id String @id @default(cuid()) name String slug String @unique description String website String focus String }